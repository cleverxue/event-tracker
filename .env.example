# ===== 飞书自定义机器人（第六章，必须开启签名校验）=====
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx
FEISHU_SECRET=your-robot-secret

# ===== 宿主机 Ollama（LLM 回填，仅 price_type=none 的记录）=====
# Docker 内通过 extra_hosts 的 host.docker.internal 访问宿主机
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
